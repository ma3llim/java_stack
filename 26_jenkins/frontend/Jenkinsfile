pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh '''
                        echo "Current directory:"
                        pwd

                        echo "Files in frontend:"
                        ls -la

                        echo "Checking package files:"
                        ls -l package.json package-lock.json
                    '''
                }
            }
        }

        // stage('Install Dependencies') {
        //     steps {
        //         dir('frontend') {
        //             sh 'npm ci'
        //         }
        //     }
        // }

        stage('Lint') {
            steps {
                dir('frontend') {
                    sh 'npm run lint'
                }
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Frontend build completed successfully'
            }
        }
    }

    post {
        success {
            echo 'Frontend CI pipeline completed successfully'
        }
        failure {
            echo 'Frontend CI pipeline failed'
        }
    }
}